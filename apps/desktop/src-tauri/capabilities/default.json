{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main desktop window API access",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "websocket:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}