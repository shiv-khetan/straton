[Unit]
Description=Straton engine
After=network.target

[Service]
Type=simple
User=straton
Group=straton
WorkingDirectory=/var/lib/straton
ExecStart=/usr/local/bin/straton-engine run
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/straton

[Install]
WantedBy=multi-user.target
