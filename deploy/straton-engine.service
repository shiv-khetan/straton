[Unit]
Description=Straton engine
After=network.target

[Service]
Type=simple
User=straton
Group=straton
WorkingDirectory=/var/lib/straton
# The Linux kernel keyring is in-memory only: without a secrets directory the KEK and
# connector secrets are lost on reboot and encrypted data becomes unreadable.
Environment=STRATON_SECRETS_DIR=/var/lib/straton/secrets
ExecStart=/usr/local/bin/straton-engine run
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/straton
# Sandboxing: the engine needs its data directory, the network and nothing else.
# ProtectHome is left off because CSV and SQLite sources may live in home directories;
# set ProtectHome=read-only if yours do not.
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# AF_NETLINK: glibc name resolution enumerates local addresses through netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
